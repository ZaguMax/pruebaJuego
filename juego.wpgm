import wollok.game.*
import personaje.*
import teclado.*
import enemigos.*
import objetos.*
import niveles.*
import gestorAnimacion.*


program rpg
{
    game.width(20)
    game.height(10)
    game.cellSize(80)

    game.title("Mi RPG")
    game.ground("celda.png")

    bancoDeImagenes.inicializar()
    gestorNiveles.iniciarJuego()

    game.start()
}

object mapaObjetos
{
    var property paredes = []
    var property monedas = []
    var property interactuables = []
    var property pinchos = []
    var property antorchas = []
    var property destinoEnemigos = []
    var property pisables = []

    method hayEn(x, y, lista) {
        return lista.any({ c => c.position().x() == x && c.position().y() == y })
    }

    method clear()
    {
        paredes.clear()
        monedas.clear()
        pinchos.clear()
        interactuables.clear()
        pisables.clear()
        destinoEnemigos.clear()
    }
}
