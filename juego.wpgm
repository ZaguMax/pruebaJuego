import wollok.game.*
import personaje.*
import teclado.*
import enemigos.*
import objetos.*
import niveles.*


program rpg {
  game.width(20)
  game.height(10)
  game.cellSize(80)
  game.title("RPG")
  game.ground("celda.png")
  gestorNiveles.iniciarJuego()
  game.start()
}

object gestorNiveles{
  var nivelActual = 1

  method iniciarJuego(){
    nivel_1.cargar()
    nivelActual = nivel_1
  }

  method pasarNivel(){
    nivelActual.limpiar()
    nivelActual.siguienteNivel().cargar()
  }
}

object mapaObjetos {
  var property paredes = []
  var property enemigosActivos = []
  var property monedas = []
  var property interactuables = []
  var property pinchos = []
  var property antorchas = []
  var property destinoEnemigos = []
  var property pisables = []

  method hayEn(x, y, lista) {
    return lista.any({ c => c.position().x() == x && c.position().y() == y })
  }

  method enemigosEn(x, y){
    return enemigosActivos.filter({ enemy => enemy.position().x() == x && enemy.position().y() == y })
  }
}