import wollok.game.*
import personaje.*
import teclado.*
import enemigos.*
import objetos.*
import niveles.*
import gestorAnimacion.*


program rpg
{
    game.width(20)
    game.height(10)
    game.cellSize(80)

    game.title("Mi RPG")
    game.ground("celda.png")

    bancoDeImagenes.inicializar()
    gestorNiveles.iniciarJuego()

    game.start()
}

object mapaObjetos
{
    var property cajas = [] 
    var property paredes = []
    var property monedas = []
    var property interactuables = []
    var property pisables = []
    var property activables = []
    
    var property enemigosActivos = gestorDeEnemigos.enemigosActivos() 

    method hayEn(x, y, lista) {
        return lista.any({ c => c.position().x() == x && c.position().y() == y })
    }

    method enemigosEn(x, y) {
        return enemigosActivos.filter({e => e.position() == game.at(x, y)})
    }

    method clear()
    {
        paredes.clear()
        monedas.clear()
        activables.clear()
        interactuables.clear()
        pisables.clear()
        cajas.clear() 
    }
}
